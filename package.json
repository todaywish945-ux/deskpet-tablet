{
  "name": "deskpet-tablet",
  "version": "0.1.0",
  "description": "平板桌宠框架 — 视频通话形态的 AI 桌面陪伴（框架开源版，角色素材自备）",
  "author": "todaywish945-ux",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "koffi": "^2.16.3",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.deskpet.tablet",
    "productName": "平板桌宠",
    "directories": {
      "output": "dist_app"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
